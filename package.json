{
  "name": "centaur-flywheel",
  "version": "1.0.0",
  "description": "半人马-飞轮 GEO品牌内容飞轮",
  "main": "dist/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on http://localhost:5173 && electron .",
    "build:vite": "tsc && vite build",
    "build:electron": "tsc -p tsconfig.electron.json && mkdir -p dist/backend/qeeclaw-core-sdk/dist && cp -r src/backend/qeeclaw-core-sdk/dist/* dist/backend/qeeclaw-core-sdk/dist/ && echo '{\"type\":\"module\"}' > dist/backend/qeeclaw-core-sdk/package.json",
    "build": "npm run build:vite && npm run build:electron",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0",
    "lucide-react": "^0.400.0",
    "date-fns": "^3.6.0",
    "openai": "^4.50.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.0",
    "electron": "^28.3.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "wait-on": "^7.2.0"
  }
}
